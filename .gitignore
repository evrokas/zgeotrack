# ZeusFW framework checkout -- vendored locally per deployment, never committed.
# See README.md "Setup" for how to fetch it and symlink web/core -> it.
web/core
fw

# Real, secret-bearing config -- copy the matching .in template and fill it in.
config/db.php
config/site.info.yaml

# Same idea, for shell tooling instead of the PHP app -- sql/msql.sh/
# msqldump.sh parse credentials straight out of this file (see their own
# comments), so it carries the same real DB_USER/DB_PASS as config/db.php
# and must never be committed either.
sql/admin.sql

# Generated by zeusfw's maker.php from web/classes/yaml/*.yaml -- regenerated
# at deploy time, never committed (same convention as zpms/erweb).
web/classes/sql/*
web/classes/*.php

files
cache
